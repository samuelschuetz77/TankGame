@page "/"
@using GameLogic
@using GameLogic.Game
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@inject SignalRService signalR;

<PageTitle>Home</PageTitle>

<form @onsubmit:preventDefault=true @onsubmit=CreateGame>
  <label class="form-label">
    New Game <input class="form-control" type="text" @bind=userInputGameName>
  </label>
  <label class="form-label d-block">
    Map
    <select class="form-select" @bind=selectedMapName>
      @foreach (var map in MapCatalog.FixedMaps)
      {
        <option value="@map.Name">@map.Name</option>
      }
    </select>
  </label>
  <div class="mb-2">
    <label class="form-label d-block">Match Type</label>
    <select class="form-select" @bind=selectedMatchType>
      <option>@GameMatchTypes.Multiplayer</option>
      <option disabled>With bots (coming soon)</option>
      <option>@GameMatchTypes.DeveloperSimulation</option>
    </select>
  </div>
  <fieldset class="mb-2">
    <legend class="form-label">Match settings</legend>
    <label class="form-label d-block">
      Reload time
      <select class="form-select" @bind=reloadTicks>
        @for (var ticks = MatchSettings.MinReloadTicks; ticks <= MatchSettings.MaxReloadTicks; ticks++)
        {
          <option value="@ticks">@((ticks / 10.0).ToString("0.0")) s</option>
        }
      </select>
    </label>
    <label class="form-label d-block">
      Bullet bounces
      <select class="form-select" @bind=maxBounces>
        @for (var bounces = 0; bounces <= MatchSettings.MaxBouncesAllowed; bounces++)
        {
          <option value="@bounces">@bounces</option>
        }
      </select>
    </label>
    <label class="form-label d-block">
      Health (hits to eliminate)
      <select class="form-select" @bind=health>
        @for (var hits = MatchSettings.MinHealth; hits <= MatchSettings.MaxHealth; hits++)
        {
          <option value="@hits">@hits</option>
        }
      </select>
    </label>
    <label class="form-label d-block">
      Tank speed
      <select class="form-select" @bind=speedMultiplier>
        @foreach (var choice in MatchSettings.SpeedChoices)
        {
          <option value="@choice">@(choice)×</option>
        }
      </select>
    </label>
    <label class="form-label d-block">
      Time limit
      <select class="form-select" @bind=timeLimitMinutes>
        @foreach (var minutes in MatchSettings.TimeLimitChoices)
        {
          <option value="@minutes">@(minutes == 0 ? "Off" : $"{minutes} min")</option>
        }
      </select>
    </label>
  </fieldset>
  <button class="btn btn-success" type="submit">Create Match</button>
</form>

@foreach (var game in games)
{
  <div>
  @game.Name (@game.Map?.Name, @game.MatchType)@(game.Status == GameStatus.Ended ? " - ended" : "")
  <button class="btn btn-primary" @onclick="() => JoinGame(game.Name)">Join Game</button>
</div>
}


@code {
  private HubConnection? hubConnection;
  private string userInputGameName = "";
  private string selectedMapName = MapCatalog.DefaultMap.Name;
  private string selectedMatchType = "Multiplayer";
  private int reloadTicks = new MatchSettings().ReloadTicks;
  private int maxBounces = new MatchSettings().MaxBounces;
  private int health = new MatchSettings().Health;
  private double speedMultiplier = new MatchSettings().SpeedMultiplier;
  private int timeLimitMinutes = new MatchSettings().TimeLimitMinutes;

  private IEnumerable<GameState> games = [];

  protected override async Task OnInitializedAsync()
  {
    await signalR.EnsureConnected();

    signalR.HubConnection?.On<IEnumerable<GameState>>(Messages.GameList, (newGames) => {
      Console.WriteLine("got game list");
      
      Console.WriteLine(JsonSerializer.Serialize(newGames));
      
      games = newGames;
      InvokeAsync(StateHasChanged);
    });

    signalR.HubConnection?.On<string, Guid>(Messages.CreatedGame, (gameName, playerId) => {
      Console.WriteLine("got created game response");
      Navigation.NavigateTo($"/game/{gameName}/player/{playerId}");
    });
    signalR.HubConnection?.On<string, Guid>(Messages.JoinedGame, (gameName, playerId) => {
      Console.WriteLine("got  game joined response");
      Navigation.NavigateTo($"/game/{gameName}/player/{playerId}");
    });

    signalR.HubConnection?.SendAsync(Messages.GetGames);
  }
  private async Task CreateGame()
  {
    Console.WriteLine("sending message to create game");
    
    var settings = new MatchSettings
    {
      ReloadTicks = reloadTicks,
      MaxBounces = maxBounces,
      Health = health,
      SpeedMultiplier = speedMultiplier,
      TimeLimitMinutes = timeLimitMinutes
    };
    signalR.HubConnection?.SendAsync(Messages.CreateGame, userInputGameName, selectedMapName, selectedMatchType, settings);
    userInputGameName = "";
  }
  
  private void JoinGame(string gameName)
  {    
    signalR.HubConnection?.SendAsync(Messages.JoinGame, gameName);
  }
}
