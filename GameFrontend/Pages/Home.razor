@page "/"
@using GameLogic
@using GameLogic.Game
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@inject SignalRService signalR;

<PageTitle>Home</PageTitle>

<form @onsubmit:preventDefault=true @onsubmit=CreateGame>
  <label class="form-label">
    New Game <input class="form-control" type="text" @bind=userInputGameName>
  </label>
  <label class="form-label d-block">
    Map
    <select class="form-select" @bind=selectedMapName>
      @foreach (var map in MapCatalog.FixedMaps)
      {
        <option value="@map.Name">@map.Name</option>
      }
    </select>
  </label>
  <div class="mb-2">
    <label class="form-label d-block">Match Type</label>
    <select class="form-select" @bind=selectedMatchType>
      <option>@GameMatchTypes.Multiplayer</option>
      <option disabled>With bots (coming soon)</option>
      <option>@GameMatchTypes.DeveloperSimulation</option>
    </select>
  </div>
  <details class="mb-3">
    <summary class="form-label fs-5">Advanced settings</summary>
    <div class="row row-cols-1 row-cols-md-3 g-3 mt-0">
    <label class="form-label col">
      Reload time
      <select class="form-select" @bind=reloadTicks>
        @for (var ticks = MatchSettings.MinReloadTicks; ticks <= MatchSettings.MaxReloadTicks; ticks++)
        {
          <option value="@ticks">@((ticks / 10.0).ToString("0.0")) s</option>
        }
      </select>
    </label>
    <label class="form-label col">
      Projectile
      <select class="form-select" @bind=projectile>
        @foreach (var type in Enum.GetValues<ProjectileType>())
        {
          <option value="@type">@type.Label()</option>
        }
      </select>
    </label>
    @if (projectile == ProjectileType.DumbBubbles)
    {
      <label class="form-label col">
        Bullet speed
        <select class="form-select" @bind=bulletSpeed>
          @foreach (var speed in MatchSettings.BulletSpeedChoices)
          {
            <option value="@speed">@speed</option>
          }
        </select>
      </label>
      <label class="form-label col">
        Bullet bounces
        <select class="form-select" @bind=maxBounces>
          @for (var bounces = 0; bounces <= MatchSettings.MaxBouncesAllowed; bounces++)
          {
            <option value="@bounces">@bounces</option>
          }
        </select>
      </label>
    }
    <label class="form-label col">
      Health (hits to eliminate)
      <select class="form-select" @bind=health>
        @for (var hits = MatchSettings.MinHealth; hits <= MatchSettings.MaxHealth; hits++)
        {
          <option value="@hits">@hits</option>
        }
      </select>
    </label>
    <label class="form-label col">
      Lives (deaths before you're out for good)
      <select class="form-select" @bind=lives>
        @for (var count = MatchSettings.MinLives; count <= MatchSettings.MaxLives; count++)
        {
          <option value="@count">@count</option>
        }
      </select>
    </label>
    <label class="form-label col">
      Respawn delay
      <select class="form-select" @bind=respawnSeconds>
        @for (var seconds = 0; seconds <= MatchSettings.MaxRespawnSeconds; seconds++)
        {
          <option value="@seconds">@seconds s</option>
        }
      </select>
    </label>
    <label class="form-label col">
      Tank speed
      <select class="form-select" @bind=speedMultiplier>
        @foreach (var choice in MatchSettings.SpeedChoices)
        {
          <option value="@choice">@(choice)×</option>
        }
      </select>
    </label>
    <label class="form-label col">
      Time limit
      <select class="form-select" @bind=timeLimitMinutes>
        @foreach (var minutes in MatchSettings.TimeLimitChoices)
        {
          <option value="@minutes">@(minutes == 0 ? "Off" : $"{minutes} min")</option>
        }
      </select>
    </label>
    </div>
  </details>
  <button class="btn btn-success" type="submit">Create Match</button>
</form>

<h4 class="mt-4">Games in progress</h4>
@if (!games.Any())
{
  <p class="text-muted">No games yet. Create one above.</p>
}
<div class="d-flex flex-wrap gap-3">
  @foreach (var game in games)
  {
    var ended = game.Status == GameStatus.Ended;
    var settings = game.Settings;
    <div class="card" style="width: 300px;">
      @if (game.Map is { } map)
      {
        @* Miniature of the map: obstacles in dark grey, spawn points as dots *@
        <svg viewBox="0 0 @map.Width @map.Height" class="card-img-top" style="background: #e9ecef; display: block;">
          @foreach (var obstacle in map.Obstacles)
          {
            <rect x="@obstacle.X" y="@obstacle.Y" width="@obstacle.Width" height="@obstacle.Height" fill="#343a40" />
          }
          @foreach (var spawn in map.SpawnPoints)
          {
            <circle cx="@(spawn.X + Tank.Size / 2)" cy="@(spawn.Y + Tank.Size / 2)" r="16" fill="#198754" />
          }
        </svg>
      }
      <div class="card-body">
        <h5 class="card-title d-flex justify-content-between align-items-center">
          @game.Name
          <span class="badge @(ended ? "bg-secondary" : "bg-success")">@(ended ? "Ended" : "In progress")</span>
        </h5>
        <h6 class="card-subtitle mb-2 text-muted">@(game.Map?.Name) · @game.MatchType · @(game.Tanks?.Count() ?? 0) player@((game.Tanks?.Count() ?? 0) == 1 ? "" : "s")</h6>
        <ul class="list-unstyled small mb-3">
          <li>Health: @settings.Health hit@(settings.Health == 1 ? "" : "s")</li>
          <li>Lives: @settings.Lives · respawn after @settings.RespawnSeconds s</li>
          <li>Projectile: @settings.Projectile.Label()</li>
          @if (settings.Projectile == ProjectileType.DumbBubbles)
          {
            <li>Bullet speed: @settings.BulletSpeed · bounces: @settings.MaxBounces</li>
          }
          <li>Reload: @((settings.ReloadTicks / 10.0).ToString("0.0")) s</li>
          <li>Tank speed: @(settings.SpeedMultiplier)×</li>
          <li>Time limit: @(settings.TimeLimitMinutes == 0 ? "off" : $"{settings.TimeLimitMinutes} min")</li>
        </ul>
        <button class="btn btn-primary" disabled="@ended" @onclick="() => JoinGame(game.Name)">Join Game</button>
      </div>
    </div>
  }
</div>


@code {
  private HubConnection? hubConnection;
  private string userInputGameName = "";
  private string selectedMapName = MapCatalog.DefaultMap.Name;
  private string selectedMatchType = "Multiplayer";
  private int reloadTicks = new MatchSettings().ReloadTicks;
  private int maxBounces = new MatchSettings().MaxBounces;
  private ProjectileType projectile = new MatchSettings().Projectile;
  private int bulletSpeed = new MatchSettings().BulletSpeed;
  private int health = new MatchSettings().Health;
  private int lives = new MatchSettings().Lives;
  private int respawnSeconds = new MatchSettings().RespawnSeconds;
  private double speedMultiplier = new MatchSettings().SpeedMultiplier;
  private int timeLimitMinutes = new MatchSettings().TimeLimitMinutes;

  private IEnumerable<GameState> games = [];

  protected override async Task OnInitializedAsync()
  {
    await signalR.EnsureConnected();

    signalR.HubConnection?.On<IEnumerable<GameState>>(Messages.GameList, (newGames) => {
      Console.WriteLine("got game list");
      
      Console.WriteLine(JsonSerializer.Serialize(newGames));
      
      games = newGames;
      InvokeAsync(StateHasChanged);
    });

    signalR.HubConnection?.On<string, Guid>(Messages.CreatedGame, (gameName, playerId) => {
      Console.WriteLine("got created game response");
      Navigation.NavigateTo($"/game/{gameName}/player/{playerId}");
    });
    signalR.HubConnection?.On<string, Guid>(Messages.JoinedGame, (gameName, playerId) => {
      Console.WriteLine("got  game joined response");
      Navigation.NavigateTo($"/game/{gameName}/player/{playerId}");
    });

    signalR.HubConnection?.SendAsync(Messages.GetGames);
  }
  private async Task CreateGame()
  {
    Console.WriteLine("sending message to create game");
    
    var settings = new MatchSettings
    {
      ReloadTicks = reloadTicks,
      MaxBounces = maxBounces,
      Projectile = projectile,
      BulletSpeed = bulletSpeed,
      Health = health,
      Lives = lives,
      RespawnSeconds = respawnSeconds,
      SpeedMultiplier = speedMultiplier,
      TimeLimitMinutes = timeLimitMinutes
    };
    signalR.HubConnection?.SendAsync(Messages.CreateGame, userInputGameName, selectedMapName, selectedMatchType, settings);
    userInputGameName = "";
  }
  
  private void JoinGame(string gameName)
  {    
    signalR.HubConnection?.SendAsync(Messages.JoinGame, gameName);
  }
}
